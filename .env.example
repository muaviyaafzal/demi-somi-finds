# Demi Somi Finds — environment variables
# Copy this file to ".env" and fill in your own values.
# NEVER commit a real .env file with secrets.

# Port the server listens on (Render sets PORT automatically).
PORT=3000

# Secret used to sign admin login tokens (JWT).
# REQUIRED in production. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, the server generates a random secret on startup and warns
# you — but then all admins are logged out on every restart.
JWT_SECRET=

# Node environment: development or production
NODE_ENV=development
